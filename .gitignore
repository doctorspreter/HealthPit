homeassistant_apps/

# Everything under test/ stays local: the working copies of the app carry
# their own Xcode projects and build output, and the Python tests beside them
# are internal too — the block further down says the same thing.
#
# The folder is called "test", singular. The rules here used to say "tests"
# and therefore matched nothing at all: `git status` listed the whole folder
# as untracked, and one `git add -A` would have swept four complete copies of
# the app, DerivedData included, into the repository.
test/
sandbox/
testordner/

# Tests und interne Unterlagen bleiben lokal; auf GitHub gehoeren sie nicht.
ios_app/Tests/
ios_app/Package.swift
ios_app/Scripts/
docs/
pytest.ini
