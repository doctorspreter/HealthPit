BRIDGE_PORT=8088
BRIDGE_USERNAME=healthpit
BRIDGE_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
BRIDGE_OTP_SHARED_SECRET=

# Optional: Hevy API key from the Hevy web app developer settings.
# The public Hevy API is currently limited to Hevy Pro accounts.
HEVY_API_KEY=
HEVY_SYNC_ENABLED=false
HEVY_MAX_PAGES=10
HEVY_SYNC_INTERVAL_MINUTES=60

# Optional: Garmin Connect import. Enable only if you want the bridge to pull
# Garmin activities into the shared workout view.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_SYNC_ENABLED=false
GARMIN_ACTIVITY_LIMIT=200
